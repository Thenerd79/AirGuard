PORT=4000
# Gateway must send this in the x-api-key header when POSTing readings
GATEWAY_API_KEY=change-me
# Leave both blank to run on the in-memory store (demo / no database)
SUPABASE_URL=
SUPABASE_SERVICE_KEY=
# Mark a device OFFLINE if no packet for this long
OFFLINE_AFTER_MS=300000
CORS_ORIGIN=*
# Leave all four blank for log-only mock notifications; set all four for Twilio delivery.
TWILIO_ACCOUNT_SID=
TWILIO_AUTH_TOKEN=
TWILIO_SMS_FROM=
TWILIO_WHATSAPP_FROM=
